# CareMap Environment Variables
# Copy this to .env.local and fill in your values

# OneMap API credentials (register at https://www.onemap.gov.sg/apidocs/register)
ONEMAP_EMAIL=your_email@example.com
ONEMAP_PASSWORD=your_password

# Google Maps API key (optional, for fallback tiles)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Cloudflare Workers AI (for SEA-LION integration later)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
